# Gemini API Key (Erforderlich für Live-KI-Analysen & Multi-Agent Deliberation)
# Holen Sie sich Ihren API-Schlüssel hier: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# JWT Secret Key für die Authentifizierung & Session-Tokens
JWT_SECRET_KEY=change-me-to-a-secure-random-secret-in-production

# CORS Konfiguration (Komma-getrennte Domains)
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
